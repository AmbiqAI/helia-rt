---
import versionHeader from '../../../tensorflow/lite/micro/helia_rt_version.h?raw';
import Hero from '@ambiqai/helia-ui/astro/Hero';
import Button from '@ambiqai/helia-ui/astro/Button';
import { Code } from 'astro:components';
import Card from '@ambiqai/helia-ui/astro/Card';

const version = versionHeader.match(/#define HELIA_RT_VERSION "([^"]+)"/)?.[1];
if (!version) throw new Error('HELIA_RT_VERSION is missing from the runtime header.');
const releaseSource = 'https://github.com/AmbiqAI/helia-rt/blob/main/.github/workflows/helia_release.yml';
const codeTheme = {
  name: 'rt-hero',
  type: 'dark' as const,
  colors: { 'editor.background': '#131b20', 'editor.foreground': '#e4e9ec' },
  tokenColors: [
    { scope: ['entity.name.type', 'entity.name.namespace', 'entity.name.scope-resolution', 'storage.type', 'support.type'], settings: { foreground: '#80cec7' } },
    { scope: ['entity.name.function', 'support.function'], settings: { foreground: '#acd3e2' } },
    { scope: ['keyword', 'storage.modifier'], settings: { foreground: '#a9bbbF' } },
    { scope: ['constant.numeric'], settings: { foreground: '#80cec7' } },
    { scope: ['variable', 'punctuation', 'keyword.operator'], settings: { foreground: '#e4e9ec' } },
  ],
};
const code = `tflite::MicroMutableOpResolver<3> resolver;
resolver.AddConv2D();
resolver.AddFullyConnected();
resolver.AddSoftmax();

tflite::MicroInterpreter interpreter(
    model, resolver, arena, kArenaSize);
interpreter.AllocateTensors();
interpreter.Invoke();`;
---

<div class="rt-opening">
  <Hero variant="contrast" palette="product" size="compact" eyebrow="heliaRT">
    <Fragment>Proven LiteRT workflows.<br />Turbocharged on Ambiq silicon.</Fragment>
    <Fragment slot="summary">heliaRT is Ambiq's optimized LiteRT runtime: the same <code>.tflite</code> models and MicroInterpreter API, backed by heliaCORE kernels tuned for Ambiq silicon.</Fragment>
    <Button slot="actions" href={`${import.meta.env.BASE_URL}/getting-started/`}>Get started</Button>
    <Button slot="actions" variant="secondary" href="#why-heliart">Why heliaRT</Button>
    <div slot="actions" class="hero-release-row"><a href="https://github.com/AmbiqAI/helia-rt/releases" aria-label={`heliaRT ${version} releases`}>{version}</a></div>
    <Card slot="media" tone="ink" class="rt-panel">
      <div class="rt-metrics">
        <a href="/helia-rt/guide/runtime/"><strong>LiteRT API</strong><span>MicroInterpreter + OpResolver</span></a>
        <a href="/helia-rt/guide/build-configuration/"><strong>heliaCORE kernels</strong><span>Selected at build time</span></a>
        <a href="/helia-rt/guide/memory-and-profiling/"><strong>Tensor arena</strong><span>Application-owned memory</span></a>
        <a href="/helia-rt/guide/memory-and-profiling/#profile-operators"><strong>Operator profiling</strong><span>Per-operator timing</span></a>
      </div>
      <figure class="rt-code">
        <figcaption><span>Inference</span><span>C++</span></figcaption>
        <Code code={code} lang="cpp" theme={codeTheme} />
      </figure>
    </Card>
  </Hero>
  <nav class="rt-ecosystems" aria-label="Integration paths and toolchains">
    <a href={`${import.meta.env.BASE_URL}/getting-started/choose-your-path/#zephyr`}>Zephyr</a>
    <a href={`${import.meta.env.BASE_URL}/getting-started/choose-your-path/#cmsis-pack`}>Arm CMSIS-Pack</a>
    <a href={`${import.meta.env.BASE_URL}/getting-started/choose-your-path/#neuralspot-x`}>neuralSPOT-X</a>
    <a href={releaseSource}>GCC</a>
    <a href={releaseSource}>Arm Compiler 6</a>
    <a href={releaseSource}>ATfE</a>
  </nav>
</div>

<style>
  .hero-release-row { flex-basis: 100%; margin-top: 2px; }
  .hero-release-row a { display: inline-flex; border: 1px solid #41454c; border-radius: 100px; padding: 4px 11px; color: #c4cbd5; font: 12px/1.5 system-ui; text-decoration: none; }
  .hero-release-row a:hover { border-color: currentColor; color: #f7faff; }
  .hero-release-row a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .rt-opening :global(.helia-hero) { min-height: 550px; padding: 40px; gap: 40px; --helia-hero-headline: 40px; }
  .rt-opening :global(.helia-hero__summary) { font-size: 16px; }
  .rt-code { margin: 0; border: 1px solid #344347; border-radius: 12px; overflow: hidden; background: #131b20; }
  .rt-code figcaption { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #2d3b40; color: #cad6d9; font-size: 12px; }
  .rt-code figcaption span:last-child { color: #80cec7; font-family: var(--sl-font-mono); }
  .rt-code :global(pre) { margin: 0; padding: 16px 14px; font-size: 12px; line-height: 1.65; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #344347 transparent; }
  .rt-code :global(code) { font-family: var(--sl-font-mono); font-size: inherit; }
  @media(max-width: 991px) { .rt-opening :global(.helia-hero) { min-height: auto; padding: 30px 24px; --helia-hero-headline: 36px; } }

  .rt-opening :global(.helia-hero) { --helia-product-accent: var(--helia-product-helia-rt); }
  .rt-opening :global(.helia-hero__actions .helia-button--primary) { background: var(--helia-product-accent); color: var(--helia-ink-black); }
  .rt-opening :global(.helia-hero__actions .helia-button--primary:hover) { background: color-mix(in srgb, var(--helia-product-accent) 88%, white); }
  .rt-opening :global(.helia-hero__actions .helia-button--secondary) { color: var(--helia-product-accent); border-color: var(--helia-product-accent); }

  .rt-opening { margin-block-end: var(--helia-space-6); }
  .rt-panel { min-width: 0; padding: 0; box-shadow: none; }
  .rt-opening :global(.helia-hero__eyebrow) { font-size: 14px; font-weight: 400; letter-spacing: .03em; }
  .rt-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
  .rt-metrics > * { padding: 10px 12px; border: 1px solid var(--helia-surface-border); border-radius: var(--helia-radius-md); text-decoration: none; }
  .rt-metrics a:hover { border-color: var(--helia-product-accent); }
  .rt-metrics strong { display: block; font-size: 17px; font-weight: var(--helia-weight-semibold); line-height: var(--helia-leading-heading); color: var(--helia-ink-primary); }
  .rt-metrics span { display: block; margin-top: var(--helia-space-2); color: var(--helia-ink-secondary); font-size: var(--helia-text-caption); line-height: var(--helia-leading-body); }
  .rt-ecosystems { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--helia-space-3); padding: var(--helia-space-5) var(--helia-space-4) 0; }
  .rt-ecosystems a { display: inline-flex; align-items: center; border: 1px solid var(--helia-surface-border); background: var(--helia-surface-paper); color: var(--helia-ink-secondary); border-radius: var(--helia-radius-pill); padding: var(--helia-space-2) var(--helia-space-3); font-size: var(--helia-text-caption); font-weight: var(--helia-weight-medium); text-decoration: none; }
  .rt-ecosystems a:hover,
  .rt-ecosystems a:focus-visible { color: var(--helia-ink-primary); border-color: var(--helia-product-accent); background: color-mix(in srgb, var(--helia-product-accent) 10%, var(--helia-surface-paper)); }
  .rt-ecosystems a:focus-visible { outline: 2px solid var(--helia-product-accent); outline-offset: 3px; }

  .rt-opening :global(.helia-hero) { position: relative; }
  .rt-opening .hero-release-row { position: absolute; top: 16px; right: 20px; margin: 0; }
  @media (max-width: 991px) {
    .rt-opening :global(.helia-hero) { row-gap: 18px; padding-top: 64px; }
    .rt-opening :global(.helia-hero__lede) { display: contents; }
    .rt-opening :global(.helia-hero__side) { order: 1; margin-top: 10px; }
    .rt-opening :global(.helia-hero__actions) { order: 2; margin-top: 10px; }
  }
</style>
