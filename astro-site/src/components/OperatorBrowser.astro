---
import operators from '../data/operators.json';
import build from '../data/build-info.json';
const families = [...new Set(operators.map(op => op.family))].sort();
const types = ['int8', 'int16', 'int32', 'int64', 'uint8', 'float32', 'float16', 'bool'];
const sourceBase = `https://github.com/AmbiqAI/helia-rt/blob/${build.commit}/tensorflow/lite/micro/kernels/helia/`;
---
<rt-operator-browser>
  <form class="operator-filters" hidden data-pagefind-ignore role="search" aria-label="Filter operators">
    <label class="operator-search">Search operators<input name="query" type="search" placeholder="Name, constraint or feature…" autocomplete="off" /></label>
    <label>Family<select name="family"><option value="">All families</option>{families.map(family => <option>{family}</option>)}</select></label>
    <label>Input type<select name="type"><option value="">All types</option>{types.map(type => <option>{type}</option>)}</select></label>
    <button type="reset">Clear filters</button>
  </form>
  <p class="operator-count" role="status" aria-live="polite" data-pagefind-ignore>{operators.length} operators</p>
  <p class="operator-empty" hidden>No operators match. Try another name, family or input type.</p>
  <div class="operator-list">
    {operators.map(op => (
      <article class="operator-item" id={`op-${op.name.toLowerCase()}`} data-family={op.family} data-types={op.types.join(' ')} data-search={`${op.name} ${op.family} ${op.types.join(' ')} ${op.notes}`.toLowerCase()}>
        <div class="operator-title"><h3><a href={`#op-${op.name.toLowerCase()}`}>{op.name}</a></h3><span>{op.family}</span></div>
        <ul class="operator-types" aria-label={`${op.name} input data types`}>{op.types.map(type => <li>{type}</li>)}</ul>
        <p>{op.notes}</p>
        <a class="operator-source" href={`${sourceBase}${op.source}`}>Adapter source <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</rt-operator-browser>
<script>
  class OperatorBrowser extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const form = this.querySelector<HTMLFormElement>('form')!;
      const rows = [...this.querySelectorAll<HTMLElement>('.operator-item')];
      const count = this.querySelector<HTMLElement>('.operator-count')!;
      const empty = this.querySelector<HTMLElement>('.operator-empty')!;
      const update = () => {
        const values = new FormData(form);
        const words = String(values.get('query') || '').trim().toLowerCase().split(/\s+/).filter(Boolean);
        const family = String(values.get('family') || '');
        const type = String(values.get('type') || '');
        let shown = 0;
        for (const row of rows) {
          const match = (!family || row.dataset.family === family) && (!type || row.dataset.types?.split(' ').includes(type)) && words.every(word => row.dataset.search?.includes(word));
          row.hidden = !match;
          if (match) shown++;
        }
        count.textContent = `${shown} of ${rows.length} operators`;
        empty.hidden = shown > 0;
      };
      form.hidden = false;
      form.addEventListener('submit', event => event.preventDefault());
      form.addEventListener('input', update);
      form.addEventListener('reset', event => {
        event.preventDefault();
        for (const control of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select')) control.value = '';
        update();
      });
    }
  }
  if (!customElements.get('rt-operator-browser')) customElements.define('rt-operator-browser', OperatorBrowser);
</script>
<style>
  rt-operator-browser { display: block; }
  .operator-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; padding: 1.2rem; border-radius: 1rem; background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5); }
  .operator-filters[hidden], .operator-item[hidden], .operator-empty[hidden] { display: none; }
  label { display: grid; gap: 0.4rem; font-size: 0.8rem; font-weight: 650; flex: 1 1 9rem; }
  .operator-search { flex-basis: 100%; }
  input, select, button { font: inherit; color: var(--sl-color-text); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 0.4rem; padding: 0.65rem; min-width: 0; }
  button { cursor: pointer; }
  input:focus-visible, select:focus-visible, button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .operator-count { color: var(--sl-color-gray-2); font-size: 0.85rem; }
  .operator-item { padding: 1.4rem 0; border-top: 1px solid var(--sl-color-gray-5); scroll-margin-top: 6rem; }
  .operator-title { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
  .operator-title h3 { font-size: 1rem; margin: 0; overflow-wrap: anywhere; }
  .operator-title h3 a { color: var(--sl-color-text); text-decoration: none; }
  .operator-title > span { color: var(--sl-color-gray-2); font-size: 0.8rem; }
  .operator-types { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.7rem 0; padding: 0; list-style: none; }
  .operator-types li { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; padding: 0.1rem 0.5rem; font: 0.75rem var(--sl-font-mono); background: var(--sl-color-gray-6); }
  .operator-item p { margin: 0.6rem 0; font-size: 0.9rem; }
  .operator-source { font-size: 0.8rem; }
</style>
