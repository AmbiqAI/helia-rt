{
  "name": "heliart-site",
  "description": "Astro Starlight documentation for heliaRT",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run prepare:docs",
    "check": "astro check",
    "reference:trial": "node scripts/reference-trial.mjs",
    "check:links": "python3 scripts/check-site-links.py",
    "prepare:docs": "node scripts/build-info.mjs && node scripts/check-operators.mjs && node scripts/check-api-index.mjs && node scripts/build-reference.mjs && node scripts/build-operator-export.mjs",
    "predev": "npm run prepare:docs",
    "prebuild": "npm run prepare:docs",
    "check:operators": "node scripts/check-operators.mjs",
    "check:output": "node scripts/check-output.mjs && helia-ui-check-discoverability --root .",
    "reference:build": "node scripts/build-reference.mjs",
    "check:reference": "node scripts/check-reference-output.mjs",
    "postbuild": "node scripts/publish-reference-markdown.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "https://codeload.github.com/AmbiqAI/helia-ui/tar.gz/f523f6008aca7e1f9b4c3a17198f3f48da83cd7a",
    "@astrojs/starlight": "^0.41.5",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "^7.0.2",
    "sharp": "^0.35.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.3"
  }
}
