# ==============================================================================
# Qualcomm Hexagon Toolchain Container for TFLite Micro
#
# Supports:
#   - Qualcomm Hexagon DSP (v66)
#   - Hexagon SDK 3.5.1
#   - Hexagon Tools 8.3.07 (hexagon-clang++, hexagon-sim)
#
# Usage:
#
# --- Build locally ---
#   docker build -f ci/Dockerfile.hexagon -t hexagon .
#
# --- Build and push to GHCR.IO ---
#   export HEXAGON_VERSION=0.5
#   docker build --no-cache -f ci/Dockerfile.hexagon -t ghcr.io/tflm-bot/hexagon:$HEXAGON_VERSION .
#   docker push ghcr.io/tflm-bot/hexagon:$HEXAGON_VERSION
#
# ==============================================================================

FROM ghcr.io/tflm-bot/hexagon:0.4 AS toolchain

FROM python:3.11-bookworm
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libncurses5 \
    libtinfo5 \
    unzip \
    wget \
    zip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY ci/bootstrap_python_trust.sh ci/check_python_trust.py ci/python_trust_constraints.txt /opt/helia-python-trust/
RUN bash /opt/helia-python-trust/bootstrap_python_trust.sh --refresh-system
ENV PIP_CONSTRAINT=/opt/helia-python-trust/python_trust_constraints.txt
RUN python3 -m pip install --no-cache-dir \
    numpy \
    Pillow

# Copy the Hexagon SDK, tools, and prebuilt core library
COPY --from=toolchain /root/Qualcomm /root/Qualcomm

ENV HEXAGON_TFLM_CORE=/root/Qualcomm/hexagon_tflm_core.a
ENV HEXAGON_CPU_VER=v66
ENV HEXAGON_SDK_ROOT=/root/Qualcomm/Hexagon_SDK/3.5.1
ENV HEXAGON_ROOT=${HEXAGON_SDK_ROOT}/tools/HEXAGON_Tools/
ENV HEXAGON_TOOL_VER=8.3.07
ENV PATH=${HEXAGON_ROOT}/${HEXAGON_TOOL_VER}/Tools/bin:${PATH}

# Configure git safe directories
RUN git config --system --add safe.directory '*'

WORKDIR /workspace

CMD ["hexagon-clang++"]

RUN python3 /opt/helia-python-trust/check_python_trust.py
